# Field Desk settings for deploy/docker-compose.yml. Copy to deploy/.env (deploy/setup.sh creates it and fills the first two);
# keep that file private (chmod 600) — it holds secrets and is never committed.

# HQ's sign-in code (setup.sh generates one) and the public address.
SUPER_ADMIN_CODE=
DOMAIN=

# Steam Guard (OTP) automation — see docs/steam-otp-api.md. All three are optional; leave them empty to keep the feature off.
#
# Bearer token the e-mail automation sends to /api/v1/steam/*. It is the only credential those routes accept and it works nowhere
# else. Use a long random value, e.g.  openssl rand -base64 32
FD_STEAM_API_KEY=
# Where a store's "Request code" is sent (the automation's request webhook) and the secret that signs each request
# (X-FieldDesk-Signature: sha256=<HMAC-SHA256 of the exact body>). Both must be set, or the Request code button stays hidden.
FD_STEAM_WEBHOOK_URL=
FD_STEAM_WEBHOOK_SECRET=
