# Copy this file to .env in this directory. Fill every blank secret before starting.
# Keep the production values on the server; never commit .env.
N8N_ENCRYPTION_KEY=
WORKER_TOKEN=
FD_API_KEY=
FD_WEBHOOK_SECRET=
MAILBOXES=[{"id":"gmail-1","provider":"gmail"},{"id":"outlook-1","provider":"outlook"}]

# Production only. Use the server's private IPv4 and n8n.<public-ip-dashes>.sslip.io.
PRIVATE_IP=
N8N_DOMAIN=

# Local Compose defaults to http://mock:8790/api/v1 when this line is absent.
# Production requires explicit owner authorization before setting the live endpoint.
# FIELD_DESK_BASE_URL=https://fieldesk.runs-at.dev/api/v1
