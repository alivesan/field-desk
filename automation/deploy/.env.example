# Copy this file to .env in this directory. Fill every blank secret before starting.
# Keep the production values on the server; never commit .env.
N8N_ENCRYPTION_KEY=
WORKER_TOKEN=
FD_API_KEY=
FD_WEBHOOK_SECRET=
# One central Gmail inbox. Add only owner-confirmed forwarding source addresses
# (up to four); current production has two Hotmail sources. No source OAuth tokens.
MAILBOXES=[{"id":"central-gmail","provider":"gmail","trustedForwarders":[]}]
# Owner-selected production policy: add requestOnly:true and allowRequestedRedirects:true
# to that mailbox object. Redirects then use the confirmed recipient and a live signed
# username request rather than original DMARC; see README. Local mock defaults stay strict.

# Production only. Use the server's private IPv4 and n8n.<public-ip-dashes>.sslip.io.
PRIVATE_IP=
N8N_DOMAIN=

# Local Compose defaults to http://mock:8790/api/v1 when this line is absent.
# Production requires explicit owner authorization before setting the live endpoint.
# FIELD_DESK_BASE_URL=https://fieldesk.runs-at.dev/api/v1
